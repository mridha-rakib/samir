# Database Configuration
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority"

# Application Environment
NODE_ENV="development"
PORT=5003
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5003"
BACKEND_IMAGE_URL="http://localhost:5003"

# JWT Settings
JWT_SECRET="your_jwt_secret"
EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="your_refresh_token_secret"
REFRESH_TOKEN_EXPIRES_IN="7d"
RESET_PASS_TOKEN="your_reset_pass_token"
RESET_PASS_TOKEN_EXPIRES_IN="15m"
RESET_PASS_LINK="http://localhost:3000/reset-password"

# Email Configuration (Nodemailer)
EMAIL="your_email@gmail.com"
APP_PASS="your_gmail_app_password"

# Stripe Settings
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_CLIENT_ID="ca_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_WEBHOOK_SECRET_2="whsec_..."
ONBOARDING_REFRESH_URL="http://localhost:3000/stripe/onboarding-refresh"
ONBOARDING_RETURN_URL="http://localhost:3000/stripe/onboarding-return"
CHECKOUT_SUCCESS_URL="http://localhost:3000/booking/success"
CHECKOUT_CANCEL_URL="http://localhost:3000/booking/cancel"

# Paystack Settings
PAYSTACK_PUBLISHABLE_KEY="pk_test_..."
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_WEBHOOK_SECRET="your_paystack_webhook_secret"

# PayPal Settings
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"

# Cloudinary Configuration
CLOUDINARY_NAME="your_cloudinary_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# DigitalOcean Spaces / S3 Storage
DO_SPACE_ENDPOINT="https://nyc3.digitaloceanspaces.com"
DO_SPACE_ACCESS_KEY="your_do_space_access_key"
DO_SPACE_SECRET_KEY="your_do_space_secret_key"
DO_SPACE_BUCKET="your_do_space_bucket_name"

# AWS S3 Storage
AWS_BUCKET_ACCESS_KEY="your_aws_access_key"
AWS_BUCKET_SECRET_KEY="your_aws_secret_key"
AWS_BUCKET_REGION="us-east-1"
AWS_BUCKET_NAME="your_aws_bucket_name"

# Twilio Configuration
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Flutterwave Settings
FLUTTERWAVE_PUBLISHABLE_KEY="FLWPUBK_TEST-..."
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-..."
FLUTTERWAVE_ENCRYPTION_KEY="FLWSECK_TEST_ENCRYPT-..."
FLUTTERWAVE_WEBHOOK_SECRET="your_flutterwave_webhook_secret"
CURRENCY="USD"
OWNER_PAYOUT_PERCENT=80
OWNER_COMMISSION_PERCENT=20

# Airbnb Sync Settings
AIRBNB_ACCESS_TOKEN="your_airbnb_access_token_here"
